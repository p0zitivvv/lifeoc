# LIFE OS — Environment Variables Example
# Local-first mode works 100% out of the box with IndexedDB (no environment variables required).

# Optional Cloud Sync & Auth with Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Web Push API VAPID keys for remote push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@lifeos.app
